{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openrails.dev/openrails/1.0.1/operation-response.schema.json",
  "title": "OperationResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["interfaceVersion", "executionProfile", "operationId", "capability", "lifecycleState", "authorizationClass", "subject", "network", "data", "errors", "provenance", "createdAt"],
  "properties": {
    "interfaceVersion": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/InterfaceVersion" },
    "executionProfile": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/ExecutionProfile" },
    "operationId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._][A-Za-z0-9]+)*$" },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._][A-Za-z0-9]+)*$" },
    "lifecycleState": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/LifecycleState" },
    "authorizationClass": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/AuthorizationClass" },
    "subject": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/Subject" },
    "network": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/NetworkReference" },
    "workspaceRef": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/WorkspaceRef" },
    "pathRef": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/PathRef" },
    "intentRef": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/IntentRef" },
    "proposalRef": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/ProposalRef" },
    "pactRef": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/PactRef" },
    "proofRefs": { "type": "array", "items": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/ProofRef" }, "uniqueItems": true },
    "data": { "oneOf": [
      { "type": "null" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/NetworkListResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/NetworkResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/CapabilitiesResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/WorkspaceResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/WorkspaceListResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ActorResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ActorListResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/PathResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/DecisionResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/IntentResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ValidationResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ProposalResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/PactResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ProofResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/RailsFlowResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/RailsCardResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/PaycardResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/PaycardListResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ReceiptResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ReceiptListResponse" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/GaiaCaseResponse" }
    ] },
    "transaction": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/transaction-state.schema.json" },
    "receipts": { "type": "array", "items": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/receipt.schema.json" } },
    "errors": { "type": "array", "items": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/interface-error.schema.json" } },
    "provenance": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/Provenance" },
    "createdAt": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/Timestamp" },
    "updatedAt": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/Timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "executionProfile": { "const": "delegated-runtime" } }, "required": ["executionProfile"] },
      "then": { "required": ["workspaceRef", "pathRef"] }
    },
    {
      "if": { "required": ["pathRef"] },
      "then": { "required": ["workspaceRef"] }
    },
    {
      "if": { "properties": { "data": { "type": "null" } }, "required": ["data"] },
      "then": { "properties": { "lifecycleState": { "enum": ["FAILED", "BLOCKED", "CANCELLED"] } } }
    },
    {
      "if": { "properties": { "lifecycleState": { "enum": ["FAILED", "BLOCKED"] } }, "required": ["lifecycleState"] },
      "then": { "properties": { "errors": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "lifecycleState": { "const": "BLOCKED" } }, "required": ["lifecycleState"] },
      "then": {
        "not": { "required": ["pactRef"] },
        "properties": {
          "transaction": {
            "required": ["status", "financialEffect"],
            "properties": {
              "status": { "const": "NOT_REQUESTED" },
              "financialEffect": { "const": "NONE" }
            }
          }
        }
      }
    }
  ]
}

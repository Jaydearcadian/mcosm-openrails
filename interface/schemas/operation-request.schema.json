{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openrails.dev/openrails/1.0.1/operation-request.schema.json",
  "title": "OperationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["interfaceVersion", "executionProfile", "operationId", "capability", "authorizationClass", "subject", "network", "data", "provenance", "createdAt"],
  "properties": {
    "interfaceVersion": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/InterfaceVersion" },
    "executionProfile": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/ExecutionProfile" },
    "operationId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._][A-Za-z0-9]+)*$" },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._][A-Za-z0-9]+)*$" },
    "authorizationClass": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/AuthorizationClass" },
    "subject": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/Subject" },
    "network": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/NetworkReference" },
    "workspaceRef": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/WorkspaceRef" },
    "pathRef": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/PathRef" },
    "intentRef": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/IntentRef" },
    "proposalRef": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/ProposalRef" },
    "pactRef": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/PactRef" },
    "proofRefs": { "type": "array", "items": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/ProofRef" }, "uniqueItems": true },
    "data": { "oneOf": [
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/EmptyRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/NetworkIdRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/WorkspaceRefRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/PathRefRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/PactRefRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ProofRefRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/PaycardRefRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ReceiptRefRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/GaiaCaseRefRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/WorkspaceRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ActorRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/PathRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/PathEvaluateRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/IntentRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ProposalRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/PactRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ProofRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/RailsFlowRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/RailsFlowInspectRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/RailsFlowPayRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/RailsCardRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/RailsCardInspectRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/RailsCardClaimRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/PaycardOpenRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/PaycardActionRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/PaycardListRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ReceiptListRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/ReceiptVerifyRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/GaiaCaseRequest" },
      { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/operation-payloads.schema.json#/$defs/GaiaResolveRequest" }
    ] },
    "provenance": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/Provenance" },
    "createdAt": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/Timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "executionProfile": { "const": "delegated-runtime" } }, "required": ["executionProfile"] },
      "then": { "required": ["workspaceRef", "pathRef"] }
    },
    {
      "if": { "required": ["pathRef"] },
      "then": { "required": ["workspaceRef"] }
    },
    {
      "if": { "properties": { "capability": { "enum": ["path.evaluate", "proposal.evaluate", "pact.prepare", "pact.activate", "proof.submit", "proof.verify", "proof.get", "railsflow.pay", "railscard.claim", "paycard.open", "paycard.get", "paycard.list", "paycard.settle", "paycard.flushResidual", "receipt.get", "receipt.list", "receipt.verify", "gaia.open", "gaia.get", "gaia.resolve"] } }, "required": ["capability"] },
      "then": { "if": { "properties": { "executionProfile": { "const": "delegated-runtime" } }, "required": ["executionProfile"] }, "then": { "required": ["intentRef"] } }
    },
    {
      "if": { "properties": { "capability": { "enum": ["proposal.evaluate", "pact.prepare", "pact.activate", "proof.submit", "proof.verify", "proof.get", "railsflow.pay", "railscard.claim", "paycard.open", "paycard.get", "paycard.list", "paycard.settle", "paycard.flushResidual", "receipt.get", "receipt.list", "receipt.verify", "gaia.open", "gaia.get", "gaia.resolve"] } }, "required": ["capability"] },
      "then": { "if": { "properties": { "executionProfile": { "const": "delegated-runtime" } }, "required": ["executionProfile"] }, "then": { "required": ["proposalRef"] } }
    },
    {
      "if": { "properties": { "capability": { "enum": ["pact.activate", "proof.submit", "proof.verify", "proof.get", "railsflow.pay", "railscard.claim", "paycard.open", "paycard.get", "paycard.list", "paycard.settle", "paycard.flushResidual", "receipt.get", "receipt.list", "receipt.verify", "gaia.open", "gaia.get", "gaia.resolve"] } }, "required": ["capability"] },
      "then": { "if": { "properties": { "executionProfile": { "const": "delegated-runtime" } }, "required": ["executionProfile"] }, "then": { "required": ["pactRef"] } }
    }
  ]
}

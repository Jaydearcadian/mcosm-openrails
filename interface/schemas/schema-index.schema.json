{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openrails.dev/openrails/1.0.1/schema-index.schema.json",
  "title": "SchemaIndex",
  "type": "object",
  "additionalProperties": false,
  "required": ["interfaceVersion", "canonicalFormat", "schemas"],
  "properties": {
    "interfaceVersion": { "$ref": "https://schemas.openrails.dev/openrails/1.0.1/common.schema.json#/$defs/InterfaceVersion" },
    "canonicalFormat": { "const": "JSON Schema 2020-12" },
    "schemas": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "path", "$id"], "properties": { "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+$" }, "path": { "type": "string", "pattern": "^[a-z0-9-]+\\.schema\\.json$" }, "$id": { "type": "string", "pattern": "^https://schemas\\.openrails\\.dev/openrails/1\\.0\\.1/[a-z0-9-]+\\.schema\\.json$" } } }, "uniqueItems": true }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openrails.dev/openrails/1.1.0/operation-registry.schema.json",
  "title": "OperationRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["interfaceVersion", "registryVersion", "sourceCapabilities", "operations"],
  "properties": {
    "interfaceVersion": { "$ref": "https://schemas.openrails.dev/openrails/1.1.0/common.schema.json#/$defs/InterfaceVersion" },
    "registryVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sourceCapabilities": { "type": "string", "const": "Product Foundry shared-interface.yaml" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "capability", "requestSchema", "responseSchema", "requestDataSchema", "responseDataSchema", "authorizationClass", "allowedExecutionProfiles", "transactionBehavior", "capabilityStatusBehavior"],
        "properties": {
          "operationId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._][A-Za-z0-9]+)*$" },
          "capability": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._][A-Za-z0-9]+)*$" },
          "requestSchema": { "type": "string", "pattern": "^https://schemas\\.openrails\\.dev/openrails/1\\.1\\.0/[a-z0-9-]+\\.schema\\.json$" },
          "responseSchema": { "type": "string", "pattern": "^https://schemas\\.openrails\\.dev/openrails/1\\.1\\.0/[a-z0-9-]+\\.schema\\.json$" },
          "requestDataSchema": { "type": "string", "pattern": "^https://schemas\\.openrails\\.dev/openrails/1\\.1\\.0/operation-payloads\\.schema\\.json#/\\$defs/[A-Za-z0-9]+$" },
          "responseDataSchema": { "type": "string", "pattern": "^https://schemas\\.openrails\\.dev/openrails/1\\.1\\.0/operation-payloads\\.schema\\.json#/\\$defs/[A-Za-z0-9]+$" },
          "authorizationClass": { "$ref": "https://schemas.openrails.dev/openrails/1.1.0/common.schema.json#/$defs/AuthorizationClass" },
          "allowedExecutionProfiles": { "type": "array", "minItems": 1, "items": { "$ref": "https://schemas.openrails.dev/openrails/1.1.0/common.schema.json#/$defs/ExecutionProfile" }, "uniqueItems": true },
          "transactionBehavior": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "submissionMeansFinancialSuccess", "financialSuccessRequirement", "failureCodes"],
            "properties": {
              "kind": { "type": "string", "enum": ["read-only", "runtime-evaluation", "wallet-signature", "wallet-transaction", "relay-signed-envelope"] },
              "submissionMeansFinancialSuccess": { "const": false },
              "financialSuccessRequirement": { "type": "string", "enum": ["none", "exact-receipt-and-vault-reconciliation"] },
              "failureCodes": { "type": "array", "items": { "$ref": "https://schemas.openrails.dev/openrails/1.1.0/common.schema.json#/$defs/ErrorCode" }, "uniqueItems": true }
            }
          },
          "capabilityStatusBehavior": {
            "type": "object",
            "additionalProperties": false,
            "required": ["onUnavailable", "onDemonstration", "onRecorded", "successClaimRule"],
            "properties": {
              "onUnavailable": {
                "type": "object",
                "additionalProperties": false,
                "required": ["lifecycleState", "transactionState", "errorCode", "financialEffect", "retryable"],
                "properties": {
                  "lifecycleState": { "const": "FAILED" },
                  "transactionState": { "const": "NOT_REQUESTED" },
                  "errorCode": { "const": "CAPABILITY_UNAVAILABLE" },
                  "financialEffect": { "const": "NONE" },
                  "retryable": { "type": "boolean" }
                }
              },
              "onDemonstration": { "type": "string", "const": "prepare-or-explain-only; do not claim live financial success" },
              "onRecorded": { "type": "string", "const": "preserve provenance and do not upgrade to LIVE without new evidence" },
              "successClaimRule": { "type": "string", "const": "financial success requires exact verified receipt and canonical reconciliation" }
            }
          }
        }
      }
    }
  }
}

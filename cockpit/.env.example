# OpenRails Cockpit — environment variables
# Copy to .env.local and fill in values.

# Privy app ID (get one at privy.io)
# Required for the wallet connection flow and embedded wallets.
VITE_PRIVY_APP_ID=

# Optional official Circle Modular Wallet browser configuration for Arc Testnet.
# These values are intended for browser use by Circle. Do not put API keys, entity secrets,
# private keys, mnemonics, or signing credentials here.
VITE_CIRCLE_CLIENT_KEY=
VITE_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# Optional managed Arc RPC. The app falls back to Arc's public providers.
# Browser environment variables are public after build. Use an origin-restricted endpoint.
VITE_ARC_RPC_URL=

# Optional: override the API base URL for legacy gateway calls.
# VITE_OPENRAILS_API_BASE=http://localhost:3001

# Shared Interface 1.2 read boundary. Production defaults to the public Worker below.
# Leave this unset in local Vite development so browser requests stay on same-origin /api;
# the Vite proxy targets the public Worker unless OPENRAILS_API_TARGET overrides it.
# VITE_OPENRAILS_INTERFACE_BASE=https://openrails-interface-worker.microcosm.workers.dev
# OPENRAILS_API_TARGET=https://openrails-interface-worker.microcosm.workers.dev

# Optional: override the sponsored transaction relay.
# VITE_OPENRAILS_RELAY_URL=https://openrails-reconciliation-worker.example.workers.dev
